# Catálogo público (Google Sheets -> site)
VITE_PROPERTIES_CSV_URL=https://docs.google.com/spreadsheets/d/1EcXVnUFR6N1IPiMvEPH5-AyGrvWQXR3T517-qmhfgqY/export?format=csv&gid=1830906592
GOOGLE_SHEET_CSV_URL=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Imoveis

# Escrita no Google Apps Script. Usada pelo cadastro de imóveis e pelo registro de cliques no WhatsApp.
# Mantenha esta URL somente no servidor.
PROPERTIES_SCRIPT_URL=https://script.google.com/macros/s/SCRIPT_DEPLOYMENT_ID/exec

# Upload de imagens. O padrão do painel é /api/upload-image.
VITE_BLOB_UPLOAD_URL=
BLOB_READ_WRITE_TOKEN=

# Microsoft Clarity no site público.
VITE_CLARITY_PROJECT_ID=

# Microsoft Clarity Data Export API. Gere em Clarity > Settings > Data Export.
# Esta variável é somente do servidor e não deve começar com VITE_.
CLARITY_API_TOKEN=
# Acesso ao /admin. Não use prefixo VITE_ para não expor as credenciais no bundle.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
# Opcional, recomendado em produção. Se vazio, a sessão deriva uma chave das credenciais acima.
ADMIN_SESSION_SECRET=
